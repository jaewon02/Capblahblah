# ─────────────── Python · Flask ───────────────
# 가상환경 (각자 python -m venv .venv; pip install -r requirements.txt)
.venv/
venv/
env/

# 바이트코드 · 캐시
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 패키징 산출물
build/
dist/
*.egg-info/

# Flask 인스턴스 폴더 · 세션 파일
instance/
flask_session/

# ─────────────── React (frontend/) ───────────────
# 각자 cd frontend; npm install. 빌드 결과(frontend/dist)는 위 dist/ 규칙으로 제외
node_modules/
npm-debug.log*

# ─────────────── 비밀값 · 개인 설정 ───────────────
# DB 비밀번호 등은 환경변수(DB_PASSWORD · SECRET_KEY)로 넘기고 파일로 올리지 않는다
.env
.env.*
!.env.example

# ─────────────── 로그 · 임시 파일 ───────────────
*.log
logs/
*.tmp
*.bak

# ─────────────── 팀 내부 문서 ───────────────
# 엑셀 3개 · 팀 문서 zip · DB 덤프는 저장소에 올리지 않고 팀원끼리 따로 공유한다
*.xlsx
*.xls
*.zip
db_dump/*
!db_dump/README.md

# ─────────────── IDE · 에디터 ───────────────
.idea/
.vscode/*
!.vscode/extensions.json

# ─────────────── Claude Code ───────────────
# Claude 설정 · 메모 파일은 저장소에 올리지 않는다
.claude/
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
**/CLAUDE.local.md

# ─────────────── OS ───────────────
.DS_Store
Thumbs.db
desktop.ini

# 엑셀 · 워드 파일을 열어 둘 때 생기는 잠금 파일
~$*
